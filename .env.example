# -----------------------------------------------------------------------------
# Mobile Tag & Asset Inspector — Environment Configuration Template
# Copy this file to ".env" and fill in real values for your PI Web API instance.
# Vite only exposes variables prefixed with VITE_ to client-side code.
# NEVER commit your real .env file — it is already excluded via .gitignore.
# -----------------------------------------------------------------------------

# Base URL of your Aveva PI Web API instance (no trailing slash)
# Example: https://pi-server.plant.local/piwebapi
VITE_PI_WEB_API_BASE_URL=https://your-pi-server.example.com/piwebapi

# PI Data Archive name as registered in PI Web API
VITE_PI_DATA_ARCHIVE=PIServer01

# Asset Server (AF Server) name as registered in PI Web API
VITE_PI_ASSET_SERVER=AFServer01

# Default AF Database to browse on load
VITE_PI_AF_DATABASE=PlantModel

# Authentication mode: "basic" | "kerberos" | "bearer"
VITE_PI_AUTH_MODE=basic

# Only used when VITE_PI_AUTH_MODE=basic (do not commit real credentials)
VITE_PI_USERNAME=svc-tag-inspector
VITE_PI_PASSWORD=change-me

# Only used when VITE_PI_AUTH_MODE=bearer
VITE_PI_BEARER_TOKEN=

# Set to "true" to force the mock data layer even if a base URL is configured
# (useful for demos, offline development, or this public GitHub Pages build)
VITE_USE_MOCK_API=true

# Polling interval for snapshot refresh, in milliseconds
VITE_SNAPSHOT_POLL_INTERVAL_MS=15000
